PORT=3000

# Supabase project settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# "anon" / "public" key -> used for auth.signUp / auth.signInWithPassword
SUPABASE_KEY=your-anon-key

# "service_role" key -> used server-side ONLY, to read/write profiles and
# reports regardless of RLS. NEVER expose this key to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
